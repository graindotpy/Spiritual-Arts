# Optional in local development. When omitted, the app uses in-memory data.
DATABASE_URL=
PORT=5000
NODE_ENV=development

# Optional Cloudflare R2 object storage. The server uses local ./uploads when
# all R2 values are absent and rejects partial R2 configuration.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional external roll notifications.
DISCORD_WEBHOOK_URL=
# Used to turn local portrait paths into absolute URLs in Discord embeds.
APP_PUBLIC_BASE_URL=

# Optional session-bound Foundry connection. Leave the mode and all Foundry
# values blank to disable it. With no explicit mode, agent ID/token selects the
# remote agent; otherwise the legacy world URL/access key selects local mode.
FOUNDRY_SESSION_MODE=
FOUNDRY_BRIDGE_USER=
# Separate website password required before a DM may start/stop the session.
FOUNDRY_CONTROL_PASSWORD=
# Hard safety limit for a session (15-1440 minutes). Defaults to eight hours.
FOUNDRY_SESSION_MAX_MINUTES=480

# Remote Zima agent mode. Use the same ID, token, and bridge-user name in its
# .env. Generate a unique 64-character hexadecimal token (`openssl rand -hex 32`).
FOUNDRY_AGENT_ID=
FOUNDRY_AGENT_TOKEN=

# Local mode only. The access key belongs to FOUNDRY_BRIDGE_USER. Set headed or
# canvas-enabled only while locally debugging; both defaults reduce production
# resource use and FOUNDRY_HEADLESS must remain true in production.
FOUNDRY_WORLD_URL=
FOUNDRY_BRIDGE_ACCESS_KEY=
FOUNDRY_HEADLESS=true
FOUNDRY_DISABLE_CANVAS=true

# Only used by the one-off R2 URL rewiring script.
R2_OLD_BASE_URL=
