# Optional in local development. When omitted, the app uses in-memory data.
DATABASE_URL=
PORT=5000
NODE_ENV=development

# Optional Cloudflare R2 object storage. The server uses local ./uploads when
# all R2 values are absent and rejects partial R2 configuration.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional external roll notifications.
DISCORD_WEBHOOK_URL=
# Used to turn local portrait paths into absolute URLs in Discord embeds.
APP_PUBLIC_BASE_URL=

# Optional session-bound Foundry browser. Leave all four secret/config values
# blank to disable the control. FOUNDRY_BRIDGE_USER is the exact Foundry player
# name shown on the world's Join Game screen; the access key belongs to it.
FOUNDRY_WORLD_URL=
FOUNDRY_BRIDGE_USER=
FOUNDRY_BRIDGE_ACCESS_KEY=
# Separate password required by the website before it may start/stop Chromium.
FOUNDRY_CONTROL_PASSWORD=
# Hard safety limit for a session (15-1440 minutes). Defaults to eight hours.
FOUNDRY_SESSION_MAX_MINUTES=480
# Set false only while locally debugging the login flow.
FOUNDRY_HEADLESS=true

# Only used by the one-off R2 URL rewiring script.
R2_OLD_BASE_URL=
